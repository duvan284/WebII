    <ul class="sidenav" id="mobile-demo">
        <li><a href="sass.html">Inicio</a></li>
        <li><a asp-area="" asp-controller="Clientes" asp-action="Index">Registro de clientes</a></li>
        <li><a class='dropdown-trigger ' href='#' data-target='dropdown2'>Procesar solicitudes ⮯</a></li>
        <!-- Dropdown Structure -->
        <ul id='dropdown2' class='dropdown-content'>
            <li><a asp-area="" asp-controller="Entregas" asp-action="Index"><i class="material-icons">motorcycle</i>Entregas a Domicilio</a></li>
            <!-- <li><a href="#!">Pedidos</a></li> -->
            <li class="divider" tabindex="-1"></li>
            <!-- <li><a href="#!">three</a></li> -->
            <li><a asp-area="" asp-controller="Facturas" asp-action="Index"><i class="material-icons">assignment</i>Facturacion</a></li>
            <li><a asp-area="" asp-controller="Pedidoes" asp-action="Index"><i class="material-icons">book</i>Pedidos clientes</a></li>
        </ul>
        <li><a asp-area="" asp-controller="Facturas" asp-action="Index">facturación</a></li>
        <li><a href="collapsible.html">Administrar información</a></li>
        <li><a asp-area="" asp-controller="Inventarios" asp-action="Index">inventario (Stack)</a></li>
        <li><a href="mobile.html">Registros</a></li>
        <a class="waves-effect waves-light btn" asp-area="" asp-controller="Home" asp-action=""  >LOGIN</a>
    </ul>
    <section class="col s12 l9">
        <h1>Tabla inventario</h1>

        <p>
            <a asp-action="Create">Crear nuevo producto</a>
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Nombre)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Descripcion)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Cantidad)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Precio)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FechaIngreso)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                        <tr>
                            <td>
                            @Html.DisplayFor(modelItem => item.Nombre)
                            </td>
                            <td>
                            @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                            <td>
                            @Html.DisplayFor(modelItem => item.Cantidad)
                            </td>
                            <td>
                            @Html.DisplayFor(modelItem => item.Precio)
                            </td>
                            <td>
                            @Html.DisplayFor(modelItem => item.FechaIngreso)
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.ProductoId">Editar</a> |
                                <a asp-action="Details" asp-route-id="@item.ProductoId">Details</a> |
                                <a asp-action="Delete" asp-route-id="@item.ProductoId">Delete</a>
                            </td>
                        </tr>
                }
            </tbody>
        </table>



    </section>

    <footer class="row">
        <div class="col s12 l12">
            <p>
                Estamos ubicados en Manizales, Caldas, Colombia.<br />
                Universidad de Caldas. Tel: 8805903 - 3136462105.<br />
                <strong>Almacen J&D - 2025</strong> <br>
                Construye facil

            </p>
        </div>
    </footer>


</body>
    
